<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.CharactersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProject.Title, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Character List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="角色列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="+" Click="AddCharacter_Click" Padding="8,4" />
            </StackPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentCharacter, Mode=TwoWay}"
                      SelectionChanged="CharacterList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Character">
                        <Grid Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Role}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Center: Character Details -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="12"
                      Visibility="{x:Bind ViewModel.IsCharacterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="12">
                <TextBlock Text="角色详情" FontSize="16" FontWeight="SemiBold" />

                <TextBox Header="姓名" Text="{x:Bind ViewModel.CharacterName, Mode=TwoWay}" />
                <TextBox Header="别名" Text="{x:Bind ViewModel.CharacterAlias, Mode=TwoWay}" />
                <TextBox Header="年龄" Text="{x:Bind ViewModel.CharacterAge, Mode=TwoWay}" InputScope="Number" />
                <TextBox Header="性别" Text="{x:Bind ViewModel.CharacterGender, Mode=TwoWay}" />
                <TextBox Header="角色定位" Text="{x:Bind ViewModel.CharacterRole, Mode=TwoWay}" />

                <TextBox Header="外貌描述" Text="{x:Bind ViewModel.CharacterAppearance, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                <TextBox Header="性格特点" Text="{x:Bind ViewModel.CharacterPersonality, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                <TextBox Header="动机" Text="{x:Bind ViewModel.CharacterMotivation, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                <TextBox Header="弱点" Text="{x:Bind ViewModel.CharacterWeakness, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                <TextBox Header="背景故事" Text="{x:Bind ViewModel.CharacterBackstory, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保存" Click="Save_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="删除" Click="Delete_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Center: Empty State -->
        <StackPanel Grid.Row="1" Grid.Column="1" Padding="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsCharacterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请选择或创建一个角色" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Right: AI Panel -->
        <Grid Grid.Row="1" Grid.Column="2" Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- Model Selector -->
            <ComboBox Grid.Row="1" Margin="0,0,0,8"
                      ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                      DisplayMemberPath="Name" />

            <!-- Chat Messages -->
            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AiChatMessage">
                                <Grid Padding="8,6"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Streaming Response -->
                    <Grid Padding="8,6"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          CornerRadius="4"
                          Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="AiInput"
                         PlaceholderText="输入消息..."
                         Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                         KeyDown="AiInput_KeyDown" />

                <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                        Click="SendAi_Click" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Page>
