<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.ScriptManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProjectTitle, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Chapter List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="章节列表" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}"
                          SelectionChanged="ChapterList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Document">
                            <Grid Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                        <Run Text="{x:Bind WordCount}" />
                                        <Run Text="字" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Center: Chapter Preview -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="请在左侧选择一个章节" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Chapter Content -->
                <Grid Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0">
                        <TextBlock Text="{x:Bind ViewModel.ChapterContent, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="15" LineHeight="28" />
                    </ScrollViewer>

                    <Button Grid.Row="1" Content="转为剧本" Click="ConvertToScript_Click"
                            Style="{ThemeResource AccentButtonStyle}" Margin="0,8,0,0"
                            IsEnabled="{x:Bind ViewModel.IsNotConverting, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.ConversionStatus, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                </Grid>
            </Grid>

            <!-- Right: AI Panel -->
            <Grid Grid.Row="1" Grid.Column="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AI 剧本助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Grid Padding="8,6"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Padding="8,6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4"
                              Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             PlaceholderText="输入剧本相关问题..."
                             Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                             KeyDown="AiInput_KeyDown" />

                    <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                            Click="SendAi_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
