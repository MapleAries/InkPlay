<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProjectTitle, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Chapter List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="章节" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="目录" Click="GenerateToc_Click" Padding="8,4" />
                    <Button Content="+" Click="AddChapter_Click" Padding="8,4" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentChapter, Mode=TwoWay}"
                          SelectionChanged="ChapterList_SelectionChanged"
                          CanReorderItems="True"
                          AllowDrop="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Document">
                            <Grid Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                        <Run Text="{x:Bind WordCount}" />
                                        <Run Text="字" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="2" Content="导出全文" Click="Export_Click"
                        HorizontalAlignment="Stretch" Margin="0,8,0,0" />
            </Grid>

            <!-- Center: Editor -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="请在左侧选择或创建一个章节" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Editor -->
                <Grid Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Format Toolbar -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <Button Content="B" Click="Format_Click" Tag="bold" FontWeight="Bold" Padding="8,4" />
                            <Button Content="I" Click="Format_Click" Tag="italic" FontStyle="Italic" Padding="8,4" />
                            <Button Content="S" Click="Format_Click" Tag="strikethrough" Padding="8,4" />
                            <TextBlock Text="|" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button Content="H1" Click="Format_Click" Tag="h1" Padding="8,4" />
                            <Button Content="H2" Click="Format_Click" Tag="h2" Padding="8,4" />
                            <Button Content="H3" Click="Format_Click" Tag="h3" Padding="8,4" />
                            <TextBlock Text="|" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button Content="引用" Click="Format_Click" Tag="quote" Padding="8,4" />
                            <Button Content="列表" Click="Format_Click" Tag="list" Padding="8,4" />
                            <Button Content="有序" Click="Format_Click" Tag="orderedlist" Padding="8,4" />
                            <Button Content="分隔" Click="Format_Click" Tag="hr" Padding="8,4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Text Editor -->
                    <TextBox Grid.Row="1"
                             x:Name="EditorBox"
                             Text="{x:Bind ViewModel.ChapterContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="EditorBox_TextChanged"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="15"
                             Padding="12" />

                    <!-- Status Bar -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="字数：" />
                                <Run Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="目标：" />
                                <Run Text="{x:Bind ViewModel.WordCountTarget, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ExportStatus, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="保存" Click="Save_Click" Padding="12,4"
                                    Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Right: AI Panel -->
            <Grid Grid.Row="1" Grid.Column="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <!-- Model Selector -->
                <ComboBox Grid.Row="1" Margin="0,0,0,8"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <!-- Quick Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                    <Button Content="续写" Click="QuickAction_Click" Tag="continue" />
                    <Button Content="重写" Click="QuickAction_Click" Tag="rewrite" />
                    <Button Content="润色" Click="QuickAction_Click" Tag="polish" />
                    <Button Content="扩写" Click="QuickAction_Click" Tag="expand" />
                    <Button Content="缩写" Click="QuickAction_Click" Tag="summarize" />
                </StackPanel>

                <!-- Chat Messages -->
                <ScrollViewer Grid.Row="3">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Grid Padding="8,6"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Streaming Response -->
                        <Grid Padding="8,6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4"
                              Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="UserInputBox"
                             PlaceholderText="输入写作需求..."
                             Text="{x:Bind ViewModel.UserInput, Mode=TwoWay}"
                             KeyDown="UserInput_KeyDown" />

                    <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                            Click="Send_Click" />

                    <Button Grid.Column="2" Content="应用" Margin="8,0,0,0"
                            Click="ApplyToEditor_Click"
                            ToolTipService.ToolTip="将AI回复应用到编辑器" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
