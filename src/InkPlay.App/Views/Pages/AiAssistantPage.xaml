<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProjectTitle, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Chapter List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="章节" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="目录" Click="GenerateToc_Click" Padding="8,4" />
                    <Button Content="+" Click="AddChapter_Click" Padding="8,4" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentChapter, Mode=TwoWay}"
                          SelectionChanged="ChapterList_SelectionChanged"
                          CanReorderItems="True"
                          AllowDrop="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Document">
                            <Grid Padding="8,6">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="重命名" Click="RenameChapter_Click" Tag="{x:Bind Id}" />
                                        <MenuFlyoutItem Text="删除" Click="DeleteChapterMenu_Click" Tag="{x:Bind Id}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                        <Run Text="{x:Bind WordCount}" />
                                        <Run Text="字" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                    <Button Content="批量写作" Click="OpenBatchDialog_Click"
                            HorizontalAlignment="Stretch" />
                    <Button Content="导出全文" Click="Export_Click"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>

            <!-- Center: Editor -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="请在左侧选择或创建一个章节" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Editor -->
                <Grid Visibility="{x:Bind ViewModel.IsChapterSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBox Grid.Row="0"
                             x:Name="TitleBox"
                             Text="{x:Bind ViewModel.ChapterTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="TitleBox_TextChanged"
                             PlaceholderText="章节标题"
                             FontSize="20" FontWeight="SemiBold"
                             Padding="12,8" />

                    <!-- Text Editor -->
                    <TextBox Grid.Row="1"
                             x:Name="EditorBox"
                             Text="{x:Bind ViewModel.ChapterContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="EditorBox_TextChanged"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="15"
                             Padding="12" />

                    <!-- Status Bar -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="字数：" />
                                <Run Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="一键写作" Click="AutoWrite_Click" Padding="12,4"
                                    Visibility="{x:Bind ViewModel.HasChapterContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <Button Content="保存" Click="Save_Click" Padding="12,4"
                                    Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Rename Dialog -->
            <Grid x:Name="RenameDialog" Grid.RowSpan="2" Grid.ColumnSpan="3"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="Collapsed">
                <Grid Width="360" Padding="24"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="重命名章节" FontSize="20" FontWeight="SemiBold" />
                        <TextBox x:Name="RenameInput" Header="章节名称" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Click="CancelRename_Click" />
                            <Button Content="确定" Style="{ThemeResource AccentButtonStyle}" Click="ConfirmRename_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Export Dialog -->
            <Grid x:Name="ExportDialog" Grid.RowSpan="2" Grid.ColumnSpan="3"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.ShowExportDialog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Width="400" Padding="24"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ExportDialogTitle, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ExportDialogMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <Button Content="确定" HorizontalAlignment="Right"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="CloseExportDialog_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Cost Estimate Dialog -->
            <Grid x:Name="CostEstimateDialog" Grid.RowSpan="2" Grid.ColumnSpan="3"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.ShowCostEstimate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Width="400" Padding="24"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="费用预估" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.CostEstimateMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" FontFamily="Consolas" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" Click="CloseCostEstimate_Click" />
                            <Button Content="继续写作" Style="{ThemeResource AccentButtonStyle}"
                                    Click="ConfirmAutoWrite_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Batch Writing Dialog -->
            <Grid x:Name="BatchDialog" Grid.RowSpan="2" Grid.ColumnSpan="3"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.ShowBatchDialog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Width="400" Padding="24"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel Spacing="16">
                        <TextBlock Text="批量写作设置" FontSize="20" FontWeight="SemiBold" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="写作章节数" FontSize="14" />
                            <NumberBox Value="{x:Bind ViewModel.BatchChapterCount, Mode=TwoWay}"
                                       Minimum="1" Maximum="50" SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="每章目标字数" FontSize="14" />
                            <NumberBox Value="{x:Bind ViewModel.BatchWordCountPerChapter, Mode=TwoWay}"
                                       Minimum="500" Maximum="10000" SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <TextBlock Text="将创建新章节并使用AI自动生成内容"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="取消" Click="CloseBatchDialog_Click" />
                            <Button Content="开始写作" Style="{ThemeResource AccentButtonStyle}"
                                    Click="ConfirmBatchWrite_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right: AI Panel -->
            <Grid Grid.Row="1" Grid.Column="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <!-- Model Selector -->
                <ComboBox Grid.Row="1" Margin="0,0,0,8"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <!-- Progress Bar (shown when auto-writing) -->
                <ProgressBar Grid.Row="2" Margin="0,0,0,8"
                             Visibility="{x:Bind ViewModel.IsAutoWriting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Value="{x:Bind ViewModel.PipelineStep, Mode=OneWay}"
                             Maximum="{x:Bind ViewModel.PipelineTotalSteps, Mode=OneWay}"
                             IsIndeterminate="True" />

                <!-- Agent Progress -->
                <TextBlock Grid.Row="3" Margin="0,0,0,4"
                           Visibility="{x:Bind ViewModel.IsAutoWriting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{x:Bind ViewModel.AgentProgressText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Revision Progress -->
                <TextBlock Grid.Row="4" Margin="0,0,0,8"
                           Visibility="{x:Bind ViewModel.IsRevising, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{x:Bind ViewModel.RevisionProgressText, Mode=OneWay}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <!-- Chat Messages (hidden when auto-writing) -->
                <ScrollViewer Grid.Row="5"
                              Visibility="{x:Bind ViewModel.IsAutoWriting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Grid Padding="8,6"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Streaming Response -->
                        <Grid Padding="8,6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4"
                              Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input / Cancel Button -->
                <Grid Grid.Row="6" Margin="0,8,0,0">
                    <!-- Normal Input (hidden when auto-writing) -->
                    <Grid Visibility="{x:Bind ViewModel.IsAutoWriting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="UserInputBox"
                                 PlaceholderText="输入写作需求..."
                                 Text="{x:Bind ViewModel.UserInput, Mode=TwoWay}"
                                 KeyDown="UserInput_KeyDown" />

                        <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                                Click="Send_Click" />

                        <Button Grid.Column="2" Content="应用" Margin="8,0,0,0"
                                Click="ApplyToEditor_Click"
                                ToolTipService.ToolTip="将AI回复应用到编辑器" />
                    </Grid>

                    <!-- Cancel Button (shown when auto-writing) -->
                    <Button Content="取消" HorizontalAlignment="Right"
                            Visibility="{x:Bind ViewModel.IsAutoWriting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="CancelAutoWrite_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
