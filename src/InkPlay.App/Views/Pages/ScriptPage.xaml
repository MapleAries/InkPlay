<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.ScriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    xmlns:controls="using:InkPlay.App.Controls"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProjectTitle, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Outline List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="大纲" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentEpisode, Mode=TwoWay}"
                          SelectionChanged="EpisodeList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Document">
                            <Grid Padding="8,6">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="重命名" Click="RenameEpisode_Click" Tag="{x:Bind Id}" />
                                        <MenuFlyoutItem Text="删除" Click="DeleteEpisodeMenu_Click" Tag="{x:Bind Id}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Center: Content Area -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsEpisodeSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="请在左侧选择一个大纲条目" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Outline Content -->
                <Grid Visibility="{x:Bind ViewModel.IsOutlineSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button x:Name="EditToggleBtn" Content="编辑" Click="EditToggle_Click" Padding="12,4" />
                    </StackPanel>

                    <!-- Preview Mode -->
                    <ScrollViewer x:Name="PreviewArea" Grid.Row="1">
                        <RichTextBlock x:Name="PreviewContent"
                                       TextWrapping="Wrap"
                                       FontSize="15" LineHeight="28" />
                    </ScrollViewer>

                    <!-- Edit Mode -->
                    <Grid x:Name="EditPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{x:Bind ViewModel.EpisodeContent, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="14"
                                 Padding="12" />

                        <Button Grid.Row="1" Content="保存" Margin="0,8,0,0"
                                Click="SaveOutline_Click" Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </Grid>

                <!-- Scene Editor -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsOutlineSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="场景编辑" FontSize="16" FontWeight="SemiBold" />

                        <TextBox Header="标题" Text="{x:Bind ViewModel.SceneHeading, Mode=TwoWay}" />
                        <TextBox Header="地点" Text="{x:Bind ViewModel.SceneLocation, Mode=TwoWay}" />
                        <TextBox Header="时间" Text="{x:Bind ViewModel.SceneTimeOfDay, Mode=TwoWay}" />

                        <TextBox Header="内容描述" Text="{x:Bind ViewModel.SceneAction, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" />

                        <!-- Dialogues -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="对话" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="+添加对话" Click="AddDialogue_Click" Padding="8,4" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SceneDialogues, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SceneDialogue">
                                        <Grid Margin="0,4" Padding="8"
                                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                              CornerRadius="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Header="角色"
                                                         Text="{x:Bind CharacterName, Mode=TwoWay}" />
                                                <Button Grid.Column="1" Content="删除" Margin="0,20,0,0"
                                                        Click="RemoveDialogue_Click" Tag="{x:Bind}" />
                                            </Grid>

                                            <TextBox Grid.Row="1" Header="括号说明"
                                                     Text="{x:Bind Parenthetical, Mode=TwoWay}" />
                                            <TextBox Grid.Row="2" Header="台词"
                                                     Text="{x:Bind Line, Mode=TwoWay}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存场景" Click="SaveScene_Click" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="删除场景" Click="DeleteScene_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Rename Dialog -->
            <Grid x:Name="RenameDialog" Grid.RowSpan="2" Grid.ColumnSpan="3"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="Collapsed">
                <Grid Width="360" Padding="24"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="重命名大纲" FontSize="20" FontWeight="SemiBold" />
                        <TextBox x:Name="RenameInput" Header="标题" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Click="CancelRename_Click" />
                            <Button Content="确定" Style="{ThemeResource AccentButtonStyle}" Click="ConfirmRename_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right: AI Panel -->
            <Grid Grid.Row="1" Grid.Column="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <!-- Model Selector -->
                <ComboBox Grid.Row="1" Margin="0,0,0,8"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <!-- Chat Messages -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Grid Padding="8,6"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Streaming Response -->
                        <Grid Padding="8,6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4"
                              Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="AiInput"
                             PlaceholderText="输入消息..."
                             Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                             KeyDown="AiInput_KeyDown" />

                    <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                            Click="SendAi_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
