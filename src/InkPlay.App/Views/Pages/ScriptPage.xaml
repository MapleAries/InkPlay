<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.ScriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: Episode/Scene List -->
        <Grid Grid.Column="0" Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="剧本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="+剧集" Click="AddEpisode_Click" Padding="8,4" />
            </StackPanel>

            <!-- Episode List -->
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentEpisode, Mode=TwoWay}"
                      SelectionChanged="EpisodeList_SelectionChanged"
                      MaxHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Document">
                        <Grid Padding="8,6">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Scene List -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="场景" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="+" Click="AddScene_Click" Padding="6,2" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentScene, Mode=TwoWay}"
                          SelectionChanged="SceneList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScriptScene">
                            <Grid Padding="8,6">
                                <TextBlock Text="{x:Bind SceneHeading}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Center: Scene Editor -->
        <ScrollViewer Grid.Column="1" Padding="12">
            <StackPanel Spacing="12">
                <TextBlock Text="场景编辑" FontSize="16" FontWeight="SemiBold" />

                <TextBox Header="场景标题" Text="{x:Bind ViewModel.SceneHeading, Mode=TwoWay}" />
                <TextBox Header="地点" Text="{x:Bind ViewModel.SceneLocation, Mode=TwoWay}" />
                <TextBox Header="时间" Text="{x:Bind ViewModel.SceneTimeOfDay, Mode=TwoWay}" />

                <TextBox Header="动作描述" Text="{x:Bind ViewModel.SceneAction, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" />

                <!-- Dialogues -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="对话" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="+添加对话" Click="AddDialogue_Click" Padding="8,4" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SceneDialogues, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SceneDialogue">
                                <Grid Margin="0,4" Padding="8"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="角色"
                                                 Text="{x:Bind CharacterName, Mode=TwoWay}" />
                                        <Button Grid.Column="1" Content="删除" Margin="0,20,0,0"
                                                Click="RemoveDialogue_Click" Tag="{x:Bind}" />
                                    </Grid>

                                    <TextBox Grid.Row="1" Header="括号说明"
                                             Text="{x:Bind Parenthetical, Mode=TwoWay}" />
                                    <TextBox Grid.Row="2" Header="台词"
                                             Text="{x:Bind Line, Mode=TwoWay}"
                                             TextWrapping="Wrap" AcceptsReturn="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保存场景" Click="SaveScene_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <Button Content="删除场景" Click="DeleteScene_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: AI Panel -->
        <Grid Grid.Column="2" Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- Quick Actions -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                <Button Content="生成大纲" Click="QuickAction_Click" Tag="outline" />
                <Button Content="生成对话" Click="QuickAction_Click" Tag="dialogue" />
                <Button Content="生成场景" Click="QuickAction_Click" Tag="scene" />
            </StackPanel>

            <!-- Chat Messages -->
            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AiChatMessage">
                                <Grid Padding="8,6"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Streaming Response -->
                    <Grid Padding="8,6"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          CornerRadius="4"
                          Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="AiInput"
                         PlaceholderText="输入消息..."
                         Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                         KeyDown="AiInput_KeyDown" />

                <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                        Click="SendAi_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
