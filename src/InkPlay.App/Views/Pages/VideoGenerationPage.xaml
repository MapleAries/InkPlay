<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.VideoGenerationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Left: Config Panel -->
        <ScrollViewer Grid.Column="0" Padding="24">
            <StackPanel Spacing="16" MaxWidth="600">
                <TextBlock Text="视频生成" FontSize="20" FontWeight="SemiBold" />

                <TextBox Header="Prompt (描述你想要生成的视频场景)"
                         Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120"
                         PlaceholderText="例如：一只金色的拉布拉多犬在海滩上奔跑，夕阳西下，浪花拍打着沙滩..." />

                <TextBox Header="Negative Prompt (不想要的内容)"
                         Text="{x:Bind ViewModel.NegativePrompt, Mode=TwoWay}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                         PlaceholderText="例如：模糊、低质量、变形..." />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel>
                        <TextBlock Text="时长" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="1" SelectionChanged="Duration_SelectionChanged">
                            <ComboBoxItem Content="3 秒" />
                            <ComboBoxItem Content="5 秒" />
                            <ComboBoxItem Content="10 秒" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="分辨率" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="1" SelectionChanged="Resolution_SelectionChanged">
                            <ComboBoxItem Content="720p" />
                            <ComboBoxItem Content="1080p" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="生成视频" Click="Generate_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsGenerating, Converter={StaticResource BoolNegationConverter}}" />
                    <Button Content="取消" Click="Cancel_Click"
                            IsEnabled="{x:Bind ViewModel.IsGenerating}" />
                </StackPanel>

                <!-- Status -->
                <TextBlock Text="{x:Bind ViewModel.GenerationStatus, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Progress Ring -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                              Width="40" Height="40" />
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Preview/Results -->
        <Grid Grid.Column="1" Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="预览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- Video Preview -->
            <Grid Grid.Row="1" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <MediaPlayerElement x:Name="VideoPlayer"
                                    Source="{x:Bind ViewModel.CurrentVideoUrl, Mode=OneWay}"
                                    AreTransportControlsEnabled="True"
                                    Visibility="{x:Bind ViewModel.CurrentVideoUrl, Converter={StaticResource StringToVisibilityConverter}}" />

                <TextBlock Text="视频预览区域"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.CurrentVideoUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>

            <!-- History -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="生成历史" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="清空" Click="ClearHistory_Click" Padding="8,2" />
                </StackPanel>

                <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoGenerationResult">
                            <Grid Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind VideoUrl}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
