<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="我的项目" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="新建项目"
                    HorizontalAlignment="Right"
                    Click="CreateProject_Click" />
        </Grid>

        <!-- Project Grid -->
        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ProjectItem_Click">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Project"
                              xmlns:models="using:InkPlay.Core.Models">
                    <Grid Width="280" Height="160" Padding="16"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"
                                   Grid.Row="0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Description}" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Grid.Row="1" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" MaxLines="3" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <TextBlock Text="{x:Bind Genre}" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind UpdatedAt}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Create Project Dialog -->
        <Grid x:Name="CreateDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="400" Padding="24"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="新建项目" FontSize="20" FontWeight="SemiBold" Grid.Row="0" Margin="0,0,0,16" />

                <TextBox Header="项目标题" Grid.Row="1" Margin="0,0,0,12"
                         Text="{x:Bind ViewModel.NewProjectTitle, Mode=TwoWay}" PlaceholderText="输入项目标题..." />

                <TextBox Header="项目描述" Grid.Row="2" Margin="0,0,0,12"
                         Text="{x:Bind ViewModel.NewProjectDescription, Mode=TwoWay}"
                         PlaceholderText="输入项目描述..."
                         TextWrapping="Wrap" AcceptsReturn="True" Height="80" />

                <ComboBox Header="类型" Grid.Row="3" Margin="0,0,0,16"
                          SelectedIndex="0"
                          x:Name="GenreComboBox">
                    <ComboBoxItem Content="短剧" IsSelected="True" />
                    <ComboBoxItem Content="小说" />
                    <ComboBoxItem Content="网文" />
                    <ComboBoxItem Content="其他" />
                </ComboBox>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="取消" Click="CancelCreate_Click" />
                    <Button Content="创建" Style="{StaticResource AccentButtonStyle}" Click="ConfirmCreate_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Project Actions Dialog -->
        <Grid x:Name="ActionsDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="500" Padding="32"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.SelectedProject.Title, Mode=OneWay}"
                           FontSize="22" FontWeight="SemiBold" Grid.Row="0" Margin="0,0,0,24" />

                <TextBlock Text="选择要进入的功能" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Grid.Row="1" Margin="0,0,0,16" />

                <StackPanel Grid.Row="2" Spacing="12">
                    <Button Content="角色管理" Tag="Characters"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="AI写作" Tag="AiAssistant"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="剧本生成" Tag="Script"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="视频生成" Tag="VideoGeneration"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />
                </StackPanel>

                <Button Grid.Row="4" Content="取消"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0"
                        Click="CancelActions_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
