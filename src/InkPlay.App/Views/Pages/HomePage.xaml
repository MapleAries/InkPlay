<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="我的小说" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="新建小说"
                    HorizontalAlignment="Right"
                    Click="CreateProject_Click" />
        </Grid>

        <!-- Project Grid -->
        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ProjectItem_Click">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Project"
                              xmlns:models="using:InkPlay.Core.Models">
                    <Grid Width="280" Height="160" Padding="16"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          Tag="{x:Bind Id}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="编辑" Click="EditProject_Click" Tag="{x:Bind Id}" />
                                <MenuFlyoutItem Text="删除" Click="DeleteProject_Click" Tag="{x:Bind Id}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"
                                   Grid.Row="0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ProjectPath}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Grid.Row="1" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Description}" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Grid.Row="2" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" MaxLines="3" />
                        <TextBlock Grid.Row="3" Text="{x:Bind UpdatedAt}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,8,0,0" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Create Project Dialog -->
        <Grid x:Name="CreateDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="480" Padding="24"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">

                <!-- Normal Form -->
                <StackPanel x:Name="CreateForm" Spacing="12">
                    <TextBlock Text="新建小说" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

                    <TextBox Header="小说标题"
                             Text="{x:Bind ViewModel.NewProjectTitle, Mode=TwoWay}" PlaceholderText="输入小说标题..." />

                    <TextBox Header="小说简介（可选）"
                             Text="{x:Bind ViewModel.NewProjectDescription, Mode=TwoWay}"
                             PlaceholderText="简要描述你的故事..."
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                    <TextBox Header="你有创作灵感或大纲吗？（可选）"
                             Text="{x:Bind ViewModel.InspirationText, Mode=TwoWay}"
                             PlaceholderText="随便写点想法，AI会帮你扩展为完整大纲..."
                             TextWrapping="Wrap" AcceptsReturn="True" Height="120" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="保存位置" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.SelectedParentDirectory, Mode=OneWay}"
                                       VerticalAlignment="Center" MaxWidth="300"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="选择目录" Click="SelectDirectory_Click" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Text="{x:Bind ViewModel.CreateStatusMessage, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="取消" Click="CancelCreate_Click" />
                        <Button Content="创建" Style="{StaticResource AccentButtonStyle}" Click="ConfirmCreate_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Loading State -->
                <StackPanel x:Name="CreateLoading" Spacing="16"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="48" Height="48" />
                    <TextBlock Text="正在创建小说并生成大纲..." FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Project Actions Dialog -->
        <Grid x:Name="ActionsDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="500" Padding="32"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.SelectedProject.Title, Mode=OneWay}"
                           FontSize="22" FontWeight="SemiBold" Grid.Row="0" Margin="0,0,0,24" />

                <TextBlock Text="选择要进入的功能" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Grid.Row="1" Margin="0,0,0,16" />

                <StackPanel Grid.Row="2" Spacing="12">
                    <Button Content="大纲规划" Tag="Script"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="角色设计" Tag="Characters"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="章节写作" Tag="AiAssistant"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />

                    <Button Content="视频生成" Tag="VideoGeneration"
                            Click="NavigateToFeature_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,12" FontSize="16" />
                </StackPanel>

                <Button Grid.Row="4" Content="取消"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0"
                        Click="CancelActions_Click" />
            </Grid>
        </Grid>

        <!-- Edit Project Dialog -->
        <Grid x:Name="EditDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="400" Padding="24"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="编辑小说" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

                    <TextBox Header="小说标题"
                             Text="{x:Bind ViewModel.EditProjectTitle, Mode=TwoWay}" />

                    <TextBox Header="小说简介"
                             Text="{x:Bind ViewModel.EditProjectDescription, Mode=TwoWay}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="取消" Click="CancelEdit_Click" />
                        <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="SaveEdit_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Delete Confirmation Dialog -->
        <Grid x:Name="DeleteDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="360" Padding="24"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="确认删除" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="确定要删除小说" />
                        <Run Text="{x:Bind ViewModel.EditProjectTitle, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="吗？此操作不可撤销。" />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="取消" Click="CancelDelete_Click" />
                        <Button Content="删除" Style="{StaticResource AccentButtonStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="ConfirmDelete_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Directory Not Found Dialog -->
        <Grid x:Name="DirectoryNotFoundDialog" Grid.RowSpan="2"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Grid Width="360" Padding="24"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="目录不存在" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="小说" />
                        <Run Text="{x:Bind ViewModel.EditProjectTitle, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="的本地目录已被删除或移动。是否从书架中移除？" />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="取消" Click="CancelRemove_Click" />
                        <Button Content="从书架移除" Style="{StaticResource AccentButtonStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="RemoveFromIndex_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
