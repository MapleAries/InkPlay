<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: Document Tree -->
        <Grid Grid.Column="0" Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="文档列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="+" Click="AddDocument_Click" Padding="8,4" />
            </StackPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentDocument, Mode=TwoWay}"
                      SelectionChanged="DocumentList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Document"
                                  xmlns:models="using:InkPlay.Core.Models">
                        <Grid Padding="8,6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Center: Editor -->
        <Grid Grid.Column="1" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="保存" Icon="Save" Click="Save_Click" />
                <Button Content="续写" Click="ContinueWriting_Click" />
                <Button Content="重写" Click="Rewrite_Click" />
                <Button Content="润色" Click="Polish_Click" />
                <Button Content="扩写" Click="Expand_Click" />
            </StackPanel>

            <!-- Text Editor -->
            <RichEditBox Grid.Row="1"
                         x:Name="Editor"
                         TextChanged="Editor_TextChanged"
                         FontSize="16"
                         Padding="16" />
        </Grid>

        <!-- Right: AI Panel -->
        <Grid Grid.Column="2" Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- Chat Messages -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AiChatMessage"
                                          xmlns:models="using:InkPlay.Core.Models">
                                <Grid Padding="8,6"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Streaming Response -->
                    <Grid Padding="8,6"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          CornerRadius="4"
                          Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="AiInput"
                         PlaceholderText="输入消息..."
                         Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                         KeyDown="AiInput_KeyDown" />

                <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                        Click="SendAi_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
