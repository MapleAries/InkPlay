<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InkPlay.App.Views.Pages.VoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InkPlay.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <!-- No Project State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="请先在书架选择一本小说" FontSize="18"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="前往书架" Margin="0,16,0,0"
                    Click="GoHome_Click" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Visibility="{x:Bind ViewModel.HasProject, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Project Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="{x:Bind ViewModel.CurrentProjectTitle, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold" Padding="12,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Left: Voice List -->
            <Grid Grid.Row="1" Grid.Column="0" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="音色列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="+" Click="AddVoice_Click" Padding="8,4" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Voices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentVoice, Mode=TwoWay}"
                          SelectionChanged="VoiceList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Voice">
                            <Grid Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Tone}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Center: Voice Details -->
            <Grid Grid.Row="1" Grid.Column="1" Padding="12">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsVoiceSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="请在左侧选择或创建一个音色" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Voice Form -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsVoiceSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="音色详情" FontSize="16" FontWeight="SemiBold" />

                        <TextBox Header="音色名称" Text="{x:Bind ViewModel.VoiceName, Mode=TwoWay}" />
                        <TextBox Header="音色描述" Text="{x:Bind ViewModel.VoiceDescription, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" />
                        <TextBox Header="性别" Text="{x:Bind ViewModel.VoiceGender, Mode=TwoWay}" />
                        <TextBox Header="年龄段" Text="{x:Bind ViewModel.VoiceAgeRange, Mode=TwoWay}"
                                 PlaceholderText="如：青年、中年、老年" />
                        <TextBox Header="语调" Text="{x:Bind ViewModel.VoiceTone, Mode=TwoWay}"
                                 PlaceholderText="如：温柔、冷酷、活泼、沉稳" />
                        <TextBox Header="语速" Text="{x:Bind ViewModel.VoiceSpeed, Mode=TwoWay}"
                                 PlaceholderText="如：缓慢、正常、快速" />
                        <TextBox Header="音调" Text="{x:Bind ViewModel.VoicePitch, Mode=TwoWay}"
                                 PlaceholderText="如：低沉、中等、高亢" />
                        <TextBox Header="示例文本" Text="{x:Bind ViewModel.VoiceSampleText, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                 PlaceholderText="展示该音色特点的示例台词..." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存" Click="Save_Click" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="删除" Click="Delete_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: AI Panel -->
            <Grid Grid.Row="1" Grid.Column="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="AI 助手" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <!-- Quick Actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                    <Button Content="生成描述" Click="QuickAction_Click" Tag="description" />
                    <Button Content="生成示例" Click="QuickAction_Click" Tag="sample" />
                </StackPanel>

                <!-- Chat Messages -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AiMessages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AiChatMessage">
                                    <Grid Padding="8,6"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Bind Role}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Streaming Response -->
                        <Grid Padding="8,6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CornerRadius="4"
                              Visibility="{x:Bind ViewModel.IsAiProcessing, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="AiInput"
                             PlaceholderText="输入消息..."
                             Text="{x:Bind ViewModel.AiUserInput, Mode=TwoWay}"
                             KeyDown="AiInput_KeyDown" />

                    <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                            Click="SendAi_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
