<Page
    x:Class="InkPlay.App.Views.Pages.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Text="资料库" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

        <!-- Tab 导航 -->
        <NavigationView Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="世界观" Icon="Globe" Tag="World"/>
                <NavigationViewItem Content="角色卡" Icon="People" Tag="Characters"/>
                <NavigationViewItem Content="术语表" Icon="Dictionary" Tag="Glossary"/>
                <NavigationViewItem Content="样章" Icon="Document" Tag="Samples"/>
            </NavigationView.MenuItems>

            <Grid Padding="16">
                <!-- 世界观 Tab -->
                <Grid x:Name="WorldPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧列表 -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="+ 新增世界观" Grid.Row="0" Margin="0,0,0,8"
                                Command="{Binding AddWorldSettingCommand}"/>

                        <ListView Grid.Row="1" ItemsSource="{Binding WorldSettings}"
                                  SelectedItem="{Binding SelectedWorldSetting, Mode=TwoWay}"
                                  SelectionChanged="WorldSetting_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 右侧编辑 -->
                    <Grid Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Header="标题" Text="{Binding EditTitle, Mode=TwoWay}" Grid.Row="0"/>
                        <TextBox Header="分类" Text="{Binding EditCategory, Mode=TwoWay}" Grid.Row="0" Margin="0,48,0,0"/>

                        <TextBox Header="内容" Text="{Binding EditContent, Mode=TwoWay}" Grid.Row="1"
                                 AcceptsReturn="True" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="删除" Margin="0,0,8,0" Command="{Binding DeleteWorldSettingCommand}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="保存" Command="{Binding SaveWorldSettingCommand}"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 角色卡 Tab -->
                <Grid x:Name="CharactersPanel" Visibility="Collapsed">
                    <ListView ItemsSource="{Binding Characters}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" Margin="0,0,0,8" CornerRadius="8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="32" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Role}" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Personality}" FontSize="12" Opacity="0.5"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 术语表 Tab -->
                <Grid x:Name="GlossaryPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧分类筛选 -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Button Content="+ 新增术语" Margin="0,0,0,8"
                                Command="{Binding AddGlossaryEntryCommand}"/>

                        <ListBox SelectedItem="{Binding SelectedCategory}">
                            <ListBoxItem Content="全部" Tag="全部"/>
                            <ListBoxItem Content="人名" Tag="人名"/>
                            <ListBoxItem Content="地名" Tag="地名"/>
                            <ListBoxItem Content="组织" Tag="组织"/>
                            <ListBoxItem Content="技能" Tag="技能"/>
                            <ListBoxItem Content="其他" Tag="其他"/>
                        </ListBox>
                    </StackPanel>

                    <!-- 右侧内容 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView Grid.Row="0" ItemsSource="{Binding GlossaryEntries}"
                                  SelectedItem="{Binding SelectedGlossaryEntry, Mode=TwoWay}"
                                  SelectionChanged="GlossaryEntry_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Term}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Definition}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Opacity="0.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 编辑区域 -->
                        <Grid Grid.Row="1" Margin="0,8,0,0"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox Header="术语" Text="{Binding EditTerm, Mode=TwoWay}" Grid.Row="0"/>
                            <TextBox Header="定义" Text="{Binding EditDefinition, Mode=TwoWay}" Grid.Row="1"
                                     AcceptsReturn="True" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="删除" Margin="0,0,8,0" Command="{Binding DeleteGlossaryEntryCommand}"/>
                                <Button Content="保存" Command="{Binding SaveGlossaryEntryCommand}"
                                        Style="{StaticResource AccentButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 样章 Tab -->
                <Grid x:Name="SamplesPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListView Grid.Column="0" ItemsSource="{Binding SampleChapters}"
                              SelectedItem="{Binding SelectedSampleChapter, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6"
                                               MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding SelectedSampleChapter.Content}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
