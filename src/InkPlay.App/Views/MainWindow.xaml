<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InkPlay.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="墨戏 - AI创作助手">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        ItemInvoked="NavView_ItemInvoked"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="首页" Icon="Home" Tag="Home" />
            <NavigationViewItem Content="大纲规划" Icon="Map" Tag="Script" />
            <NavigationViewItem Content="角色设计" Icon="People" Tag="Characters" />
            <NavigationViewItem Content="章节写作" Icon="Edit" Tag="AiAssistant" />
            <NavigationViewItem Content="视频生成" Icon="Play" Tag="VideoGeneration" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="设置" Icon="Setting" Tag="Settings" />
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
