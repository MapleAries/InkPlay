<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InkPlay.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InkPlay - AI写作助手">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="True"
        ItemInvoked="NavView_ItemInvoked"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="首页" Icon="Home" Tag="Home" />
            <NavigationViewItem Content="编辑器" Icon="Edit" Tag="Editor" />
            <NavigationViewItem Content="角色管理" Icon="People" Tag="Characters" />
            <NavigationViewItem Content="剧本工坊" Icon="Video" Tag="Script" />
            <NavigationViewItem Content="AI 助手" Icon="Robot" Tag="AiAssistant" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
